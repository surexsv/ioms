# Sample environment file for IOMS.
# Copy to .env on the server (never commit real secrets).
# Load via systemd EnvironmentFile, gunicorn env, or `export $(grep -v '^#' .env | xargs)`.

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your.domain.com,www.your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com,https://www.your.domain.com

# PostgreSQL
DATABASE_NAME=iomsdb
DATABASE_USER=ioms_user
DATABASE_PASSWORD=replace-with-strong-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
# DATABASE_CONN_MAX_AGE=60

# TLS / reverse-proxy (set SECURE_SSL_REDIRECT=False only for temporary HTTP tests)
SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False

# Optional local development overrides
# DJANGO_SETTINGS_MODULE=config.settings.development
# SECRET_KEY=django-insecure-local-only
